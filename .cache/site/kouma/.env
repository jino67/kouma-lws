APP_NAME=Kouma
APP_ENV=production
APP_KEY=base64:QSu8xln4LvkthfDaAN12TWaKAlKzBlZ2mAG+gCD5u5Q=
APP_DEBUG=false
APP_URL=https://kouma.site

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Un fichier par jour, quatorze jours gardes : le quota du mutualise n'est pas extensible.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Base MySQL de LWS (le .sql livre a cote du zip s'importe dans phpMyAdmin).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinus1658531_2dgjay
DB_USERNAME=sinus1658531_2dgjay
DB_PASSWORD="dloi1ptpqt"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   a activer une fois le HTTPS verifie sur kouma.site

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# sync : aucun processus permanent ne tourne en mutualise pour vider une file. Les reponses WhatsApp et la lecture
# des documents se font donc pendant la requete. Avec un serveur dedie : database, plus un worker.
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.kouma.site
MAIL_PORT=465
MAIL_USERNAME=contac@kouma.site
# Le mot de passe de la boite contac@kouma.site. S'il change dans le panneau LWS, le changer ici le meme jour :
# sinon plus aucune alerte ni reinitialisation de mot de passe ne part.
MAIL_PASSWORD="fH8*9YXfEmzyxeR"
MAIL_FROM_ADDRESS="contac@kouma.site"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Compte administrateur (cree dans le .sql ; son mot de passe est dans identifiants-admin.txt).
PLATFORM_ADMIN_EMAIL=contac@kouma.site
PLATFORM_ADMIN_NAME="Administration"

# Contacts affiches sur le site. Les Parametres de la plateforme (Administration) sont prioritaires.
BRAND_EMAIL=contac@kouma.site
BRAND_WHATSAPP=

